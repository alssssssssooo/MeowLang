print("hello", 1 + 2)
print("mul", 6 * 7, "pow", 2 ** 10)
print("div", 7 // 2, -7 // 2, 7 % 3, -7 % 3)

x = 10
x += 5
print("x", x)

if x > 10:
    print("big")
elif x == 10:
    print("ten")
else:
    print("small")

i = 0
total = 0
while i < 5:
    total += i
    i += 1
print("while", total)

for n in range(1, 6):
    total += n
print("for", total)

for ch in "abc":
    print("ch", ch)

a = [1, 2, 3]
a.append(4)
print("list", a, len(a), a[0], a[-1])
print("slice", a[1:3], a[:2], a[2:])
a[0] = 9
print("set", a)
print("pop", a.pop(), a)


def fact(n):
    if n <= 1:
        return 1
    return n * fact(n - 1)


print("fact", fact(6))


def fib(n):
    if n < 2:
        return n
    return fib(n - 1) + fib(n - 2)


print("fib", fib(10))
print("str", str(123) + "!", "int", int("42") + 1)
print("truth", 0 or 5, 1 and 7, not 0)
print("ternary", "yes" if 3 > 2 else "no")
print("in", 3 in [1, 2, 3], "b" in "abc")
print("random", random(10) >= 0)
print("range", range(5, 0, -1))
print("text", textLen("喵a"), charAt("喵a", 1), substring("meow", 1, 2), join(["a", "b"], "-"))
